# ===== DISCORD BOT SETTINGS =====
DISCORD_TOKEN=your_discord_bot_token_here

PROMPT_FILE=prompts/prompt-example.txt  # Path to system prompt

CHANGE_NICKNAME=False                 # Should the bot auto-update its nickname?
# Backend for text chat: 'openai' (OpenRouter/OpenAI) or 'ollama' (local Ollama)
TEXT_BACKEND=openai

# Context storage controls
# When true, the bot stores conversation state in memory only and does not write to disk.
IN_MEMORY_CONTEXT_ONLY=false
# Path to context storage file when file-based context is enabled.
# For production, restrict permissions on this file (e.g., chmod 600) to protect contents.
CONTEXT_FILE_PATH=context.json

# ===== SERVER ARCHIVE SETTINGS =====
SERVER_ARCHIVE_ENABLED=true
SERVER_ARCHIVE_DB_PATH=./data/server_archive.db
SERVER_ARCHIVE_QUEUE_MAX=1000
SERVER_ARCHIVE_BATCH_SIZE=100
SERVER_ARCHIVE_SEARCH_LIMIT=10
SERVER_ARCHIVE_ADMIN_ONLY=true
SERVER_ARCHIVE_SYNC_ON_START=true
SERVER_ARCHIVE_LIVE_TAIL=true
SERVER_ARCHIVE_MAX_MESSAGE_CHARS=8000
SERVER_ARCHIVE_ARCHIVE_BOT_MESSAGES=false

# ===== OPENAI / OPENROUTER SETTINGS =====
OPENAI_API_KEY=your_o...here
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_TEXT_MODEL=deepseek/deepseek-chat-v3-0324:free

VL_MODEL=moonshotai/kimi-vl-a3b-thinking:free

# ===== NVIDIA NIM SETTINGS =====
# NVIDIA NIM reuses OPENAI_* environment variables when TEXT_BACKEND=nvidia
# To use NVIDIA NIM:
# 1. Set TEXT_BACKEND=nvidia
# 2. Set OPENAI_API_KEY to your NVIDIA API key
# 3. Set OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
# 4. Set OPENAI_TEXT_MODEL to a NVIDIA model (e.g., meta/llama3-70b-instruct)
# Optional: NVIDIA-specific overrides (only needed if different from OPENAI_* vars)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_TEXT_MODEL=meta/llama3-70b-instruct

# =============================================================================
# FALLBACK MODEL CONFIGURATION
# =============================================================================

# VISION MODEL FALLBACK LADDER
# Models are tried in order - if first fails, try second, then third, etc.
VISION_FALLBACK_MODELS=moonshotai/kimi-vl-a3b-thinking:free,mistralai/mistral-small-3.2-24b-instruct:free,mistralai/mistral-small-3.2-24b-instruct:free

# VISION MODEL TIMEOUTS (seconds for each model above)
VISION_FALLBACK_TIMEOUTS=12.0,15.0,18.0

# TEXT MODEL FALLBACK LADDER
TEXT_FALLBACK_MODELS=deepseek/deepseek-r1-0528:free,deepseek/deepseek-chat-v3-0324:free,z-ai/glm-4.5-air:free

# TEXT MODEL TIMEOUTS (seconds for each model above)
TEXT_FALLBACK_TIMEOUTS=20.0,25.0,30.0

# MULTIMODAL PROCESSING CONFIGURATION
MULTIMODAL_PER_ITEM_BUDGET=45.0

# ===== OLLAMA SETTINGS (uncomment if using Ollama as TEXT_BACKEND) =====
# OLLAMA_BASE_URL=http://localhost:11434
# TEXT_MODEL=qwen3-235b-a22b      # Or any Ollama model name (see `ollama list`)

# ===== TTS SETTINGS =====
TTS_ENGINE=kokoro-onnx
TTS_VOICE=am_michael
TTS_MODEL_PATH=tts/onnx/kokoro-v1.0.onnx
TTS_VOICES_PATH=tts/voices/voices-v1.0.bin
TTS_LANGUAGE=en

# ===== ADMIN ALERT SYSTEM =====
ALERT_ENABLE=false                           # Enable/disable the admin DM alert system
ALERT_ADMIN_USER_IDS=your_discord_user_id_here      # Comma-separated Discord user IDs authorized to use !alert
ALERT_SESSION_TIMEOUT_S=1800                 # Alert session timeout in seconds (30 minutes)
TTS_MODEL_FILE=tts/onnx/kokoro-v1.0.onnx

# ===== RAG SYSTEM SETTINGS =====
ENABLE_RAG=true                        # Enable/disable RAG system
RAG_DB_PATH=./chroma_db               # ChromaDB storage path
RAG_KB_PATH=kb                        # Knowledge base directory

# RAG Performance & Loading
# Set RAG_EAGER_VECTOR_LOAD=false to enable lazy loading (non-blocking, immediate replies preserved)
RAG_EAGER_VECTOR_LOAD=true            # Load vector index at startup (true) or lazily on first search (false)
RAG_BACKGROUND_INDEXING=true          # Process new documents asynchronously (true) or synchronously (false)

# RAG Embedding Model
RAG_EMBEDDING_MODEL_TYPE=sentence-transformers
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# RAG Search Parameters
RAG_VECTOR_CONFIDENCE_THRESHOLD=0.7   # Minimum confidence for vector results
RAG_MAX_VECTOR_RESULTS=5              # Maximum vector search results
RAG_VECTOR_WEIGHT=0.7                 # Weight for vector search (0.0-1.0)
RAG_MAX_KEYWORD_RESULTS=3             # Maximum keyword search results
RAG_KEYWORD_WEIGHT=0.3                # Weight for keyword search (0.0-1.0)

# RAG Fallback Behavior
RAG_FALLBACK_ON_FAILURE=true          # Fallback to keyword search on vector failure
RAG_FALLBACK_ON_LOW_CONFIDENCE=true   # Fallback to keyword search on low confidence
RAG_MIN_RESULTS_THRESHOLD=1           # Minimum results before fallback

# RAG Result Processing
RAG_COMBINE_RESULTS=true              # Combine vector and keyword results
RAG_MAX_COMBINED_RESULTS=5            # Maximum combined results
RAG_DEDUPLICATION_THRESHOLD=0.9       # Similarity threshold for deduplication

# RAG Chunking
RAG_CHUNK_SIZE=512                    # Text chunk size in tokens
RAG_CHUNK_OVERLAP=50                  # Overlap between chunks
RAG_MIN_CHUNK_SIZE=100                # Minimum chunk size

# RAG Access Control
RAG_ENFORCE_USER_SCOPING=true         # Enforce user-based access control
RAG_ENFORCE_GUILD_SCOPING=true        # Enforce guild-based access control

# RAG Logging
RAG_LOG_RETRIEVAL_PATHS=true          # Log retrieval decision paths
RAG_LOG_CONFIDENCE_SCORES=true        # Log confidence scores

# RAG Background Processing
RAG_INDEXING_QUEUE_SIZE=256           # Maximum items in indexing queue (backpressure)
RAG_INDEXING_WORKERS=2                # Number of background indexing workers
RAG_INDEXING_BATCH_SIZE=32            # Documents to process per batch/flush
RAG_LAZY_LOAD_TIMEOUT=0.0             # Seconds to wait in search path for lazy load (0.0 = never block)

# ===== ONLINE SEARCH (DDG default, pluggable custom) =====
SEARCH_PROVIDER=ddg                   # ddg | custom
SEARCH_MAX_RESULTS=5
SEARCH_SAFE=moderate                  # off|moderate|strict
SEARCH_LOCALE=
DDG_API_ENDPOINT=https://duckduckgo.com/html/
DDG_TIMEOUT_MS=5000
CUSTOM_SEARCH_API_ENDPOINT=
CUSTOM_SEARCH_API_KEY=
CUSTOM_SEARCH_HEADERS=
CUSTOM_SEARCH_TIMEOUT_MS=8000
CUSTOM_SEARCH_RESULT_PATHS=
SEARCH_POOL_MAX_CONNECTIONS=10
SEARCH_BREAKER_FAILURE_WINDOW=5
SEARCH_BREAKER_OPEN_MS=15000
SEARCH_BREAKER_HALFOPEN_PROB=0.25

# ===== STREAMING STATUS CARDS =====
STREAMING_ENABLE=false
STREAMING_EMBED_STYLE=compact         # compact | detailed
STREAMING_TICK_MS=750
STREAMING_MAX_STEPS=8

# Per-domain streaming eligibility toggles
# Text-only flows should not show streaming cards by default (single final message only)
STREAMING_ENABLE_TEXT=false           # true enables cards for pure text flows (default false)
STREAMING_ENABLE_SEARCH=false         # true enables cards for online search flows
STREAMING_ENABLE_RAG=false            # true enables cards for RAG retrieval/ingest flows
STREAMING_ENABLE_MEDIA=true           # true keeps cards for heavy media (images/video/audio/PDF/screenshots)

# ===== STT ORCHESTRATION =====
# Enable orchestrated STT pipeline (falls back to legacy STT when false)
STT_ENABLE=true

# Orchestration mode:
#   single | cascade_primary_then_fallbacks | parallel_first_acceptable | parallel_best_of | hybrid_draft_then_finalize
STT_MODE=single

# Comma-separated list of active providers. Currently supported: local_whisper
STT_ACTIVE_PROVIDERS=local_whisper

# Acceptance threshold for providers that emit confidence (0.0-1.0)
STT_CONFIDENCE_MIN=0.0

# Cache settings (seconds)
STT_CACHE_TTL=600

# Local provider concurrency limit
STT_LOCAL_CONCURRENCY=2

# ===== MULTIMODAL STT FALLBACK CONFIGURATION =====
# Enable multimodal fallback when primary STT fails
STT_MULTIMODAL_FALLBACK_ENABLED=false

# Comma-separated list of multimodal models for fallback (OpenRouter format)
# Models must be different from vision models and capable of audio processing
STT_MULTIMODAL_FALLBACK_MODELS=allenai/molmo-2-8b:free,nvidia/nemotron-nano-12b-v2-vl:free

# Timeout for multimodal fallback API calls (seconds)
STT_MULTIMODAL_FALLBACK_TIMEOUT_S=30.0

# Minimum confidence threshold for fallback results (0.0-1.0)
STT_MULTIMODAL_FALLBACK_MIN_CONFIDENCE=0.5

# Maximum retry attempts for multimodal fallback
STT_MULTIMODAL_FALLBACK_MAX_RETRIES=1

# ===== X / TWITTER API (API-first with strict fallback) =====
# Enable X API integration (requires bearer token)
X_API_ENABLED=false
X_API_BEARER_TOKEN=

# Fallback behavior
X_API_REQUIRE_API_FOR_TWITTER=false     # If true, do not scrape/fallback when API fails (401/403/404/410)
X_API_ALLOW_FALLBACK_ON_5XX=true        # Allow generic extraction fallback on 5xx/429

# Fast probe: attempt STT on X URLs before API/syndication (helps video tweets route to STT)
X_TWITTER_STT_PROBE_FIRST=true

# Photo media routing to Vision-Language analysis (disabled by default)
X_API_ROUTE_PHOTOS_TO_VL=false

# Networking & resilience
X_API_TIMEOUT_MS=8000
X_API_RETRY_MAX_ATTEMPTS=5
X_API_BREAKER_FAILURE_WINDOW=5
X_API_BREAKER_OPEN_MS=15000
X_API_BREAKER_HALFOPEN_PROB=0.25

# Hydration fields (comma-separated)
X_TWEET_FIELDS=id,text,created_at,author_id,public_metrics,possibly_sensitive,lang,attachments,entities,referenced_tweets,conversation_id
X_EXPANSIONS=author_id,attachments.media_keys,referenced_tweets.id,referenced_tweets.id.author_id
X_MEDIA_FIELDS=media_key,type,url,preview_image_url,variants,width,height,alt_text,public_metrics
X_USER_FIELDS=id,name,username,profile_image_url,verified,protected
X_POLL_FIELDS=

# ===== VISION GENERATION SYSTEM =====
# Enable Vision generation features (text-to-image, image editing, video generation)
VISION_ENABLED=false
# API key for Vision providers (Together.ai, Novita.ai)
VISION_API_KEY=your_vision_api_key_here
# Comma-separated list of allowed providers: together,novita
VISION_ALLOWED_PROVIDERS=together,novita
# Default provider to use: together or novita
VISION_DEFAULT_PROVIDER=together

# Vision System Paths
# Path to Vision safety policy configuration file
VISION_POLICY_PATH=configs/vision_policy.json
# Base directory for Vision system data storage
VISION_DATA_DIR=vision_data
# Directory for generated artifacts (images, videos)
VISION_ARTIFACTS_DIR=vision_data/artifacts
# Directory for job state persistence
VISION_JOBS_DIR=vision_data/jobs
# Path to budget and cost ledger file
VISION_LEDGER_PATH=vision_data/ledger.jsonl

# Vision System Performance & Limits
# Maximum concurrent Vision jobs across all users
VISION_MAX_CONCURRENT_JOBS=5
# Maximum concurrent jobs per user
VISION_MAX_USER_CONCURRENT_JOBS=2
# Job timeout in seconds (5 minutes default)
VISION_JOB_TIMEOUT_SECONDS=300
# Artifact cache TTL in days
VISION_ARTIFACT_TTL_DAYS=7

# ===== TWITTER THREAD UNROLL (author self-replies only) =====
# Gate the feature on/off without code changes (enabled by default)
TWITTER_UNROLL_ENABLED=true
# Limits to avoid blowing prompt budget
TWITTER_UNROLL_MAX_TWEETS=30
TWITTER_UNROLL_MAX_CHARS=6000
TWITTER_UNROLL_TIMEOUT_S=15
# Maximum size per artifact in MB
VISION_MAX_ARTIFACT_SIZE_MB=50
# Maximum total artifacts storage in GB
VISION_MAX_TOTAL_ARTIFACTS_GB=5
# Budget per job in USD
VISION_BUDGET_PER_JOB_USD=0.25
# Daily budget in USD
VISION_BUDGET_DAILY_USD=5.00

# Vision System Providers & Retry
# Log level for Vision system: DEBUG, INFO, WARNING, ERROR
VISION_LOG_LEVEL=INFO
# Enable detailed audit logging for all Vision operations
VISION_AUDIT_ENABLED=true
# Provider API timeout in milliseconds
VISION_PROVIDER_TIMEOUT_MS=30000
# Maximum provider retry attempts
VISION_PROVIDER_MAX_RETRIES=2
# Base delay between retries in milliseconds
VISION_PROVIDER_RETRY_DELAY_MS=1000

# VISION_MODEL: Pin specific model/endpoint (optional runtime override)
# Examples: novita:qwen-image, novita:sdxl, together:flux.1-pro, qwen-image, flux.1-pro
VISION_MODEL=""

# Vision System Discord Integration
# Progress update interval for Discord messages in seconds
VISION_PROGRESS_UPDATE_INTERVAL_S=10
# Use ephemeral responses for slash commands (true/false)
VISION_EPHEMERAL_RESPONSES=false
# Enable dry run mode (no actual API calls, testing only)
VISION_DRY_RUN_MODE=false

# Conversational image editing: mention/reply the bot with an image + an edit
# instruction (e.g. "@bot give this guy a beard") and it runs img2img via the
# same orchestrator/safety/budget path as /imgedit - no slash command needed.
# Per-guild toggle: !feature image_editing on|off
VISION_CONVERSATIONAL_EDIT_ENABLED=true
# Max seconds to wait for a conversational edit job before giving up (bounded wait) [REH]
VISION_CONVERSATIONAL_EDIT_TIMEOUT_S=90.0
# Seconds between job-status polls while waiting for the edit to finish
VISION_CONVERSATIONAL_EDIT_POLL_INTERVAL_S=2.0
# Extra comma-separated edit-intent trigger phrases, merged with the built-in
# defaults (edit/remove/change/... plus "give him"/"make it"/... imperatives).
VISION_EDIT_INTENT_KEYWORDS=

# ===== LOGGING =====
# By default, console tracebacks do NOT show local variables: `config` (a
# plain dict holding every secret in this file — DISCORD_TOKEN,
# OPENAI_API_KEY, NVIDIA_NIM_API_KEY, etc.) is a local in several hot paths
# (bot/ai_backend.py, bot/openai_backend.py), and the pretty console handler
# runs at DEBUG unconditionally, so any ERROR traceback would otherwise dump
# every secret in cleartext. Only enable for local debugging.
# LOG_TRACEBACK_LOCALS=1
# JSONL log rotation [PA]: logs/bot.jsonl rotates (rename, not copy+truncate)
# once it hits this size; LOG_ROTATION_BACKUPS old copies are kept before the
# janitor compresses/prunes them per LOG_RETENTION_DAYS.
# LOG_ROTATION_SIZE_MB=50
# LOG_ROTATION_BACKUPS=5

# ===== BOT SETTINGS =====
TEMPERATURE=0.2
PRESENCE_PENALTY=0.5
TIMEOUT=120.0
MAX_CONVERSATION_LENGTH=50
MAX_USER_MEMORY=1000
MEMORY_SAVE_INTERVAL=30
# How often (seconds) to flush ContextManager/EnhancedContextManager to disk if
# dirty [PA]. append()/append_message() only mark an in-memory dirty flag now
# instead of writing on every single message; this task does the actual write.
# CONTEXT_AUTOSAVE_INTERVAL_SECONDS=20

# ===== RESOURCE / MEMORY MANAGEMENT =====
# glibc malloc arena cap, applied via mallopt() at startup (bot/main.py).
# Lower = less per-thread heap fragmentation, at a small concurrency cost.
# No effect on non-glibc platforms (musl, macOS, Windows).
MALLOC_ARENA_MAX=2
# Health-check RSS threshold (MB) above which a warning is logged and a
# best-effort reclaim runs (gc.collect + idle STT model eviction + malloc_trim).
# Default is sized for a bot with STT/RAG models loaded; lower it for a
# text-only deployment, raise it if you run multiple large STT models.
MEMORY_WARNING_THRESHOLD=1200
# Whether the high-memory reclaim should also evict idle (non-default) cached
# STT whisper models, e.g. a "tiny" model left over from a slow_decode
# downgrade. Set false if you'd rather keep them warm at the cost of memory.
MEMORY_EVICT_STT_CACHE_ON_WARNING=true
# Max distinct whisper model variants (by size+compute_type) kept resident at
# once; the default model always counts as one slot and is never evicted.
# Each additional cached variant pins tens-to-hundreds of MB. (bot/stt.py)
STT_MODEL_CACHE_MAX=2
# RSS (MB) at which the in-progress whisper decode aborts and returns a
# partial transcript rather than continuing to completion. (bot/hear.py)
STT_MEMORY_ABORT_THRESHOLD_MB=900

# ===== PLAYWRIGHT REMOTE SERVER =====
# WebSocket endpoint of the remote Playwright server
# (Docker playwright:v1.59.1-noble on port 3006).
# Accepts ws://, wss://, http://, or https:// (http/https are normalised to ws/wss).
# When set, all browser automation (web extraction Tier-B, thread unroll, screenshots)
# connects to this server.  No local-browser fallback exists.
PW_SERVER_URL=ws://localhost:3006

# ===== SCREENSHOT API =====
SCREENSHOT_API_KEY=your_screenshot_api_key_here
SCREENSHOT_API_URL=https://api.screenshotmachine.com
SCREENSHOT_API_DEVICE=desktop
SCREENSHOT_API_DIMENSION=1024x768
SCREENSHOT_API_FORMAT=jpg
SCREENSHOT_API_DELAY=2000
SCREENSHOT_API_COOKIES=
SCREENSHOT_FALLBACK_PLAYWRIGHT=true
SCREENSHOT_PW_VIEWPORT=1280x1024
SCREENSHOT_PW_TIMEOUT_MS=15000
SCREENSHOT_PW_USER_AGENT=

# ===== PROMETHEUS METRICS =====
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8000
PROMETHEUS_HTTP_SERVER=true

# ===== SEARCH TUNING =====
DDG_FORCE_HTML=true
SEARCH_POOL_MAX_CONNECTIONS=10
SEARCH_BREAKER_FAILURE_WINDOW=5
SEARCH_BREAKER_OPEN_MS=15000
SEARCH_BREAKER_HALFOPEN_PROB=0.25
SEARCH_INLINE_MAX_CONCURRENCY=3

# ===== NETWORKING =====
HTTP2_ENABLE=true
HTTP_DNS_CACHE_TTL_S=300
HTTP_MAX_CONNECTIONS=64
HTTP_MAX_KEEPALIVE_CONNECTIONS=32
HTTP_CONNECT_TIMEOUT_MS=1500
HTTP_READ_TIMEOUT_MS=5000
HTTP_TOTAL_DEADLINE_MS=6000

# ===== TWEET FLOW OPTIMIZATION =====
TWEET_FLOW_ENABLED=true
TWEET_SYNDICATION_TOTAL_DEADLINE_MS=3500
TWEET_WEB_TIER_A_MS=2500
TWEET_WEB_TIER_B_MS=8000
TWEET_WEB_TIER_C_MS=8000
X_API_TOTAL_DEADLINE_MS=6000
TWEET_CACHE_TTL_S=86400
TWEET_NEGATIVE_TTL_S=900

# ===== STT OPTIMIZATION =====
STT_GLOBAL_MAX_CONCURRENCY=3
STT_TOTAL_DEADLINE_MS=300000
STT_CACHE_TTL_S=604800

# ===== GENERAL URL PROCESSING =====
WEB_TIER_A_MS=2000
WEB_TIER_B_MS=8000
WEB_TIER_C_MS=8000
WEB_FAST_FAIL_SPA_HOSTS=medium.com,heavy.com

# ===== OCR PROCESSING =====
OCR_GLOBAL_DEADLINE_MS=240000
OCR_BATCH_DEADLINE_MS=20000

# ===== CACHING & SINGLE-FLIGHT =====
CACHE_SINGLE_FLIGHT_ENABLE=true
CACHE_READABILITY_TTL_S=14400
CACHE_BACKEND=memory
CACHE_DIR=.cache/router

# ===== RESOURCE REDUCTION (commented = default behaviour) =====
# LOW_RESOURCE_MODE=true
# --- Thread caps (prevent oversubscription on NAS/constrained hosts) ---
# OMP_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# MKL_NUM_THREADS=1
# NUMEXPR_NUM_THREADS=1
# TOKENIZERS_PARALLELISM=false
# ORT_INTRA_OP_NUM_THREADS=1
# ORT_INTER_OP_NUM_THREADS=1
# --- Subsystem concurrency caps ---
# RAG_INDEXING_WORKERS=1
# RAG_INDEXING_BATCH_SIZE=8
# RAG_QUERY_TOP_K=3
# RAG_MAX_VECTOR_RESULTS=3
# STT_LOCAL_CONCURRENCY=1
# TTS_CONCURRENCY=1
# VISION_MAX_CONCURRENT_JOBS=2
# PLAYWRIGHT_MAX_CONCURRENCY=1
# HTTP_MAX_CONNECTIONS=16
# --- Media caps ---
# MULTIMODAL_MAX_TOTAL_BYTES=5242880
# PDF_MAX_PAGES=5
# VIDEO_MAX_DURATION_S=60
# AUDIO_MAX_DURATION_S=60
# VL_MAX_TOTAL_BYTES=5242880
# VL_MAX_IMAGE_DIMENSION=1920
# --- Cache cleanup ---
# Low-resource mode auto-reduces TTLs; janitor enforces size caps

# ===== DASHBOARD SETTINGS =====
# Owner-only web dashboard for operational visibility and controlled bot actions.
# Default: disabled. Bind to localhost. Requires explicit auth token.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8011
DASHBOARD_PUBLIC_BIND=false
DASHBOARD_AUTH_TOKEN=         # REQUIRED when enabled — strong random string
DASHBOARD_SESSION_SECRET=     # Optional — auto-generated if unset (one-time)
DASHBOARD_OWNER_IDS=          # Comma-separated Discord user IDs (falls back to OWNER_IDS)
DASHBOARD_RATE_LIMIT_SENDS_PER_MINUTE=5
DASHBOARD_AUDIT_DB_PATH=./data/dashboard_audit.db
DASHBOARD_DM_ARCHIVE_ENABLED=true
DASHBOARD_DM_RETENTION_DAYS=90
DASHBOARD_AUDIT_RETENTION_DAYS=180
DASHBOARD_MAX_MESSAGE_CHARS=1800
DASHBOARD_SHOW_MESSAGE_PREVIEWS=true
# ===== AMBIENT REPLY (opt-in unprompted replies) =====
# When enabled, the bot occasionally replies to messages it wasn't addressed in.
# This is rare by design — use cooldowns + probability to keep it subtle.
# Per-guild toggle available via: !feature ambient on|off
#
# AMBIENT_REPLY_ENABLED=false              # Master switch; default off
# AMBIENT_REPLY_PROBABILITY=0.002          # 0.2% chance per eligible message
# AMBIENT_REPLY_MIN_CHARS=12              # Ignore very short messages ("lol", emoji)
# AMBIENT_REPLY_CHANNEL_COOLDOWN_S=1800   # Min seconds between fires in one channel (30m)
# AMBIENT_REPLY_GLOBAL_COOLDOWN_S=600     # Min seconds between any ambient fire (10m)
# AMBIENT_REPLY_CHANNELS=                 # Comma-separated channel IDs; empty = all
# AMBIENT_REPLY_QUIET_HOURS=              # "HH-HH" UTC range to suppress (e.g. 23-7)
